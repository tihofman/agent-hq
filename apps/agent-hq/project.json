{
  "name": "agent-hq",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/agent-hq/src",
  "targets": {
    "start": {
      "command": "HOST=${HOST:-127.0.0.1} PORT=${PORT:-3333} node build",
      "options": {
        "cwd": "apps/agent-hq"
      },
      "dependsOn": ["build"]
    },
    "serve": {
      "command": "vite dev",
      "options": {
        "cwd": "apps/agent-hq"
      }
    },
    "build": {
      "command": "vite build && ../../scripts/check-client-bundle.sh",
      "options": {
        "cwd": "apps/agent-hq"
      },
      "outputs": ["{workspaceRoot}/apps/agent-hq/build"]
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/agent-hq"
      }
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "apps/agent-hq"
      }
    },
    "typecheck": {
      "command": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
      "options": {
        "cwd": "apps/agent-hq"
      }
    }
  }
}
